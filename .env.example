# Browser-visible (must be NEXT_PUBLIC_*; never put secrets here).
# Leave EMPTY: the browser is same-origin and Next proxies /api + /ws to
# BACKEND_ORIGIN. An absolute value drops the SameSite=Lax cookie (ADR-0017).
NEXT_PUBLIC_API_BASE_URL=

# Server-side proxy target for the /api + /ws rewrites (next.config.mjs).
BACKEND_ORIGIN=http://localhost:8000

# Server-runtime only — used by middleware/route handlers if added
SENTRY_BACKEND_URL=http://localhost:8000
